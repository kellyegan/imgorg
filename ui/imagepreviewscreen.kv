<ImagePreviewScreen>:
  name: "preview"

  BoxLayout:
    id: preview_box
    orientation: "vertical"
    spacing: dp(25)
    padding: dp(50)

    AsyncImage:
      id: image_preview
      fit_mode: "contain" # or scale-down
      source: f"http://127.0.0.1:8000/image/{root.current_image['id']}" if root.current_image is not None else ""