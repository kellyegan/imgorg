<StatusLabel>:
    text_size: self.size
    halign: "left"
    valign: "center"
    font_size: dp(20)
    size_hint: (1, None)
    height: dp(30)

<FileToggle>:
    text: root.path
    group: root.hash
    size_hint: 1, None
    height: dp(30)
    text_size: self.size
    halign: "left"
    valign: "center"
    padding: (dp(12), 0)

<ImageChooser>:
    orientation: "horizontal"
    size_hint: (1, None)
    height: max(image_thumb.height, image_list.height)
    spacing: dp(18)

    AnchorLayout:
        size_hint: None, 1
        width: dp(100)
        anchor_y: "top"

        Image:
            id: image_thumb
            source: root.get_thumbnail()
            size_hint: None, None
            width: self.parent.width
            height: self.parent.width / self.image_ratio

    AnchorLayout:
        anchor_y: "top"

        GridLayout:
            id: image_list
            cols: 1
            size_hint: (1, None)
            height: self.minimum_height
            spacing: dp(4)

<DuplicatesList>:
    cols: 1
    spacing: dp(12)

    Label:
        text: root.title
        text_size: self.size
        halign: "left"
        valign: "center"
        font_size: dp(20)
        size_hint: (1, None)
        height: dp(30)

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        GridLayout:
            id: duplicates_list
            cols: 1
            spacing: dp(18)
            size_hint: (1, None)
            height: self.minimum_height

<ImportScreen>:
    name: "import"

    GridLayout:
        cols: 1
        padding: [dp(96), dp(48)]
        spacing: dp(18)

        Label:
            text: "Import images"
            text_size: self.size
            halign: 'left'
            valign: 'top' 
            font_size: "48sp"
            size_hint_y: None
            height: "60sp"

        GridLayout:
            id: lists
            cols: 1
            padding: [0, 0]
            spacing: dp(18)

        BoxLayout:
            id: submit_buttons
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(48)
            spacing: "10sp"

            Button:
                text: "Cancel"
                font_size: "18sp"
                bold: True
                color: (1, 0, 0, 1)
                background_normal: ""
                background_color: (0.3, 0.3, 0.3, 1)
                on_release: root.exit_import()

            Button:
                text: "Import"
                font_size: "18sp"
                bold: True
                color: (0, 0.6, 0.8, 1)
                background_normal: ""
                background_color: (0.3, 0.3, 0.3, 1)
                on_release: root.import_images()