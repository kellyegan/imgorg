<FileToggle>:
    text: root.path
    group: root.hash
    size_hint: 1, None
    height: dp(30)
    text_size: self.size
    halign: "left"
    valign: "center"
    padding: (dp(12), 0)

<ImageChooser>:
    orientation: "horizontal"
    size_hint: (1, None)
    height: max(image_thumb.height, image_list.height)
    spacing: dp(18)

    AnchorLayout:
        size_hint: None, 1
        width: dp(100)
        anchor_y: "top"

        Image:
            id: image_thumb
            # source: "/Users/kpe/Desktop/Level_0/14305059168_6f889b3b49_o.jpg" # VERTICAL
            # source: "/Users/kpe/Desktop/Level_0/8663892916_f048be298f_o.jpg" # HORIZONTAL
            source: root.get_thumbnail()
            size_hint: None, None
            width: self.parent.width
            height: self.parent.width / self.image_ratio

    AnchorLayout:
        anchor_y: "top"

        GridLayout:
            id: image_list
            cols: 1
            size_hint: (1, None)
            height: self.minimum_height
            spacing: dp(4)

            FileToggle:
                path: "/Users/kpe/Desktop/Level_0/8663892916_f048be298f_o.jpg"
                hash: root.hash
            FileToggle:
                path: "/Users/kpe/Desktop/Level_0/14305059168_6f889b3b49_o.jpg"
                hash: root.hash

<DuplicatesList>:
    cols: 1
    spacing: dp(12)

    Label:
        text: root.title
        text_size: self.size
        halign: "left"
        valign: "center"
        font_size: dp(24)
        size_hint: (1, None)
        height: dp(30)

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        GridLayout:
            id: duplicates_list
            cols: 1
            spacing: dp(18)
            size_hint: (1, None)
            height: self.minimum_height

            ImageChooser:
                hash: "group-1"
                image_list: [{"path":"/Users/kpe/Desktop/Level_0/8663892916_f048be298f_o.jpg"}, {"path": "/Users/kpe/Desktop/Level_0/14305059168_6f889b3b49_o.jpg"},{"path":"/Users/kpe/Desktop/Level_0/39737483343_97c4be7232_o.jpg"}]
            ImageChooser:
                hash: "group-2"
                image_list: [{"path": "/Users/kpe/Desktop/Level_0/14305059168_6f889b3b49_o.jpg"}, {"path":"/Users/kpe/Desktop/Level_0/8663892916_f048be298f_o.jpg"}]
            ImageChooser: 
                hash: "group-3"
                image_list: [{"path": "/Users/kpe/Desktop/Level_0/39737483343_97c4be7232_o.jpg"}, {"path":"/Users/kpe/Desktop/Level_0/8663892916_f048be298f_o.jpg"}]


<ImportScreen>:
    name: "import"

    GridLayout:
        cols: 1
        padding: [dp(48), dp(24)]
        spacing: dp(18)

        Label:
            text: "Import images"
            text_size: self.size
            halign: 'left'
            valign: 'top' 
            font_size: "48sp"
            size_hint_y: None
            height: "60sp"

        DuplicatesList:
            title: "Duplicate imports"

        DuplicatesList:
            title: "Images already in catalog"

        BoxLayout:
            id: submit_buttons
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(48)
            spacing: "10sp"

            Button:
                text: "Cancel"
                font_size: "18sp"
                bold: True
                color: (1, 0, 0, 1)
                background_normal: ""
                background_color: (0.3, 0.3, 0.3, 1)
                on_release: app.view_thumbnail_browser()

            Button:
                text: "Import"
                font_size: "18sp"
                bold: True
                color: (0, 0.6, 0.8, 1)
                background_normal: ""
                background_color: (0.3, 0.3, 0.3, 1)