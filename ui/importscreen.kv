<ImportScreen>:
  name: "import"

  BoxLayout:
    orientation: "vertical"
    spacing: dp(25)
    padding: dp(50)

    Label:
      text: "Import images"
      text_size: self.size
      halign: 'left'
      valign: 'top'
      font_size: "48sp"
      size_hint_y: 0.2

    BoxLayout:
      id: import_duplicates
      orientation: "vertical"
      spacing: dp(10)
      padding: dp(5)

      Label:
        text:"These images appear to be the same. Which do you want to import?"
        text_size: self.size
        halign: 'left'
        valign: 'top'
        font_size: "24sp"

      BoxLayout:
        orientation: "horizontal"
        
        Button:
          text: "Choice 1"
        Button:
          text: "Choice 1"

      BoxLayout:
        orientation: "horizontal"
        
        Button:
          text: "Choice 1"
        Button:
          text: "Choice 1"

      BoxLayout:
        orientation: "horizontal"
        
        Button:
          text: "Choice 1"
        Button:
          text: "Choice 1"

    BoxLayout:
      id: catalog_duplicates
      orientation: "vertical"
      spacing: dp(10)
      padding: dp(5)

      Label:
        text: "These images are already in the catalog. Do you want to update the filepath?"
        text_size: self.size
        halign: 'left'
        valign: 'top'
        font_size: "24sp"

    BoxLayout:
      orientation: "horizontal"
      size_hint_y: 0.2
      spacing: dp(10)

      Button:
        text: "Cancel"
        on_release: app.view_thumbnail_browser()
      Button:
        text: "Import images"
