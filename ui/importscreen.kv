<FileToggle>:
    text_size: self.size
    halign: "left"
    valign: "center"
    size_hint_y: None
    height: dp(30)
    padding: "10sp"
    group: root.hash
    text: root.path

<ImageChooser>:
    orientation: 'horizontal'
    padding: 0
    spacing: dp(10)
    size_hint_y: None
    heigth: self.minimum_height

    AnchorLayout:
        size_hint_x: None
        width: dp(100)
        anchor_y: "top"
        padding: 0
        spacing: 0

        Image:
            id: preview_image
            source: root.image_list[0]["path"] if len(root.image_list) > 0 else ""
            size_hint: None, None
            width: self.parent.width
            height: min(self.parent.width / self.image_ratio, dp(100))
            fit_mode: "contain"

        Widget:
        
    # Toggles for each image are added as children of this grid layout
    GridLayout:
        id: image_list
        cols: 1
        size_hint_y: None
        heigth: self.minimum_height
        spacing: dp(2)
        padding: 0

<DuplicatesList>:
    cols: 1
    spacing: dp(12)

    Label:
        text: root.title
        text_size: self.size
        halign: 'left'
        valign: 'top' 
        font_size: "24sp"
        size_hint_y: None
        height: "30sp"

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        GridLayout:
            id: duplicates_list
            cols: 1
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(12)

            ImageChooser:
                hash: "group-1" 
                image_list: [{"path": "ui/images/image_missing.png"}, {"path": "B"}, {"path": "C"}]

            ImageChooser:
                hash: "group-2" 
                image_list: [{"path": "/Users/kpegan/Desktop/Level_0/52019144128_f82c5b190d_o.jpg"}, {"path": "B"}, {"path": "C"}]

            ImageChooser:
                hash: "group-3" 
                image_list: [{"path": "/Users/kpegan/Desktop/Level_0/52019144128_f82c5b190d_o.jpg"}, {"path": "B"}, {"path": "C"}, {"path": "D"}]

            ImageChooser:
                hash: "group-1" 
                image_list: [{"path": "/Users/kpegan/Desktop/Level_0/52019144128_f82c5b190d_o.jpg"}, {"path": "B"}, {"path": "C"}]

            ImageChooser:
                hash: "group-2" 
                image_list: [{"path": "/Users/kpegan/Desktop/Level_0/52019144128_f82c5b190d_o.jpg"}, {"path": "B"}, {"path": "C"}]

            ImageChooser:
                hash: "group-3" 
                image_list: [{"path": "/Users/kpegan/Desktop/Level_0/52019144128_f82c5b190d_o.jpg"}, {"path": "B"}, {"path": "C"}]


<ImportScreen>:
    name: "import"

    GridLayout:
        cols: 1
        padding: [dp(48), dp(24)]
        spacing: dp(18)

        Label:
            text: "Import images"
            text_size: self.size
            halign: 'left'
            valign: 'top' 
            font_size: "48sp"
            size_hint_y: None
            height: "60sp"

        DuplicatesList:
            title: "Duplicate imports"

        DuplicatesList:
            title: "Images already in catalog"

        BoxLayout:
            id: submit_buttons
            orientation: 'horizontal'
            size_hint_y: None
            height: dp(48)
            spacing: "10sp"

            Button:
                text: "Cancel"
                font_size: "18sp"
                bold: True
                color: (1, 0, 0, 1)
                background_normal: ""
                background_color: (0.3, 0.3, 0.3, 1)
                on_release: app.view_thumbnail_browser()

            Button:
                text: "Import"
                font_size: "18sp"
                bold: True
                color: (0, 0.6, 0.8, 1)
                background_normal: ""
                background_color: (0.3, 0.3, 0.3, 1)